# OpenRouter API (required — get a key at https://openrouter.ai)
OPENROUTER_API_KEY=your_key_here

# LLM models
LLM_TEXT_MODEL=qwen/qwen3.6-35b-a3b
LLM_VLM_MODEL=qwen/qwen3.6-35b-a3b

# Embedding
EMBED_MODEL=qwen/qwen3-embedding-8b
EMBED_DIM=4096

# Milvus (local Milvus Lite — no Docker needed)
MILVUS_DB_PATH=./milvus_lite.db
MILVUS_DB_NAME=
MILVUS_COLLECTION=rag_multimodal_collection

# RAG
RAG_WORKING_DIR=rag_workdir
MINERU_DEVICE=cuda

# Vector storage (NanoVectorDBStorage = JSON files, MilvusVectorDBStorage = Milvus Lite)
VECTOR_STORAGE=MilvusVectorDBStorage

# RAGAnything processing
ENABLE_IMAGE_PROCESSING=true
ENABLE_TABLE_PROCESSING=true
ENABLE_EQUATION_PROCESSING=true
RAG_PARSER=mineru
PARSE_METHOD=auto
CONTEXT_WINDOW=1
CONTEXT_MODE=page
MAX_CONTEXT_TOKENS=2000

# Reranker (uses OpenRouter — no separate key needed)
RERANKER_ENABLED=true
RERANKER_MODEL=cohere/rerank-v3.5

# Language
SUMMARY_LANGUAGE=Vietnamese
QUERY_USER_PROMPT=Always respond in Vietnamese (Tiếng Việt). Use Vietnamese terminology.

# FastAPI
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# Runtime
TIMEOUT=120
MAX_RETRIES=3
LOG_LEVEL=INFO
