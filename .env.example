# OpenRouter API (required — get a key at https://openrouter.ai)
OPENROUTER_API_KEY=your_key_here

# LLM models
LLM_TEXT_MODEL=qwen/qwen3-30b-a3b
LLM_VLM_MODEL=qwen/qwen2.5-vl-72b-instruct

# Embedding
EMBED_MODEL=qwen/qwen3-embedding-8b
EMBED_DIM=768

# Milvus (local Milvus Lite — no Docker needed)
MILVUS_DB_PATH=./milvus_lite.db
MILVUS_COLLECTION=rag_multimodal_collection

# RAG
RAG_WORKING_DIR=rag_workdir

# FastAPI
ALLOWED_ORIGINS=["http://localhost:8501","http://localhost:3000"]

# Runtime
TIMEOUT=120
MAX_RETRIES=3
LOG_LEVEL=INFO
