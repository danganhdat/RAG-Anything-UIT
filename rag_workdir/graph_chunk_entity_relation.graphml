  <data key="d1">table</data>
  <data key="d2">This table defines financial support levels (2-25 million VND) for scientific publications based on prestige criteria, directly supporting the institutional guidelines for student and postgraduate research funding outlined in the surrounding content.</data>
  <data key="d3">chunk-0ead19da6e8f0cbb729126138bfd438b</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
