<node id="Regulation Implementation Terms for Academic Advisors (list)">
  <data key="d0">Regulation Implementation Terms for Academic Advisors (list)</data>
  <data key="d1">list</data>
  <data key="d2">A regulatory list outlining the effective date of CVHT guidelines and procedures for addressing implementation issues, ensuring compliance through institutional oversight and Rectorial authority. Highlights procedural accountability and ties to broader administrative frameworks.</data>
  <data key="d3">chunk-103fb159a2bd04f33c3309c4f43c7fe9</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
  <data key="d5">1779107566</data>
