  <data key="d1">table</data>
  <data key="d2">This table facilitates proposals for financial support for scientific publications by students, postgraduates, and doctoral candidates. It aligns with the institution's two annual evaluation periods (June and November) and outlines the collaboration between departments to ensure proper budget allocation and commendation processes.</data>
  <data key="d3">chunk-1c2884f32a2d1a31fe3a067d1a046465</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
  <data key="d5">1779117621</data>
</node>
