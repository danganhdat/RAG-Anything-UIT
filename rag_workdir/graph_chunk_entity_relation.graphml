  <data key="d1">list</data>
  <data key="d2">This list outlines roles and attendance data for academic advising and class management. It includes the Academic Advisor, class leadership positions, and student attendance metrics, supporting administrative documentation and reporting within educational institutions.</data>
  <data key="d3">chunk-2b863dd0ac05aa5dee00ed04d485a60c</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
  <data key="d5">1779107566</data>
