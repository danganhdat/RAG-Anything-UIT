  <data key="d1">table</data>
  <data key="d2">This table is a template for tracking research publications by students and postgraduates, aligning with formal submission requirements. It structures data on academic units, publication rankings, and individual contributions but remains empty, indicating it is a pre-filled framework awaiting data entry for research recognition purposes.</data>
  <data key="d3">chunk-f09edd09c7cc34c6e2657a969d7c5117</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
