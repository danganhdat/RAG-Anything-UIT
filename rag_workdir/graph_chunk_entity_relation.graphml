<node id="Support and Recognition Guidelines for Academic Publications (table)">
  <data key="d0">Support and Recognition Guidelines for Academic Publications (table)</data>
  <data key="d1">table</data>
  <data key="d2">This table defines financial support percentages (100% for main authors, 50% for student co-authors) and recognition criteria for academic publications, aligning with institutional policies to ensure equitable funding and commendations for SV, HVCH, and NCS as outlined in Articles 5 and 6.</data>
  <data key="d3">chunk-76e024fe5d29a40bfd37b44ae8a09c0c</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
