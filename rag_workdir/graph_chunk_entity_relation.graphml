  <data key="d5">1779107566</data>
</node>
<node id="Nhiệm vụ và Quy trình của Cố vấn Học tập (CVHT) (list)">
  <data key="d0">Nhiệm vụ và Quy trình của Cố vấn Học tập (CVHT) (list)</data>
  <data key="d1">list</data>
  <data key="d2">This list outlines specific tasks for CVHTs in master's programs, including student counseling, report submission, and class organization. It supports institutional academic management by ensuring student guidance and procedural compliance, aligning with broader regulatory frameworks for postgraduate education.</data>
  <data key="d3">chunk-f29a6ff07f1bc69ffd953b99b67c3ae1</data>
  <data key="d4">cam_nang_sau_dai_hoc_2025_0.pdf</data>
